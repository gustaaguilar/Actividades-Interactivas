  <activity class="@textGrid.WordSearch" name="sopa_mascotas" code="">
   <description />
   <messages>
    <cell type="initial">
     <style>
      <font family="Arial" size="20" bold="true" />
      <color foreground="0xFFFFFF" background="0x1A4A1A" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="cons_sopa_mascotas.mp3" />
     <p>Encontrá: CLUTCH - MAPLE - ZAYU</p>
    </cell>
    <cell avoidOverlapping="true" image="i01-bienhecho.jpg" type="final">
     <style>
      <font family="Arial" size="26" bold="true" />
      <color foreground="0xFFFFFF" background="0x1A4A1A" />
     </style>
     <p>¡Muy bien!</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <helpWindow showSolution="true" />
    <container bgColor="0x1A4A1A">
     <gradient source="0x2A6A2A" dest="0x0A2A0A" angle="0" />
     <image name="fondo_selva.png" tiled="true" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFF9900" border="true" />
   </settings>
   <textGrid rows="8" columns="5" cellWidth="48.0" cellHeight="48.0" border="true">
    <style margin="2">
     <font family="Arial" size="20" bold="true" />
     <color foreground="0xFFFF00" background="0x1A4A1A" />
    </style>
    <text>
     <row>CLUTCH**</row>
     <row>********</row>
     <row>**ZAYU**</row>
     <row>********</row>
     <row>*MAPLE**</row>
    </text>
   </textGrid>
   <clues>
    <clue id="0">CLUTCH</clue>
    <clue id="1">MAPLE</clue>
    <clue id="2">ZAYU</clue>
   </clues>
   <cells rows="3" cols="1" cellWidth="140.0" cellHeight="140.0" border="true" id="secondary">
    <style />
    <shaper class="@Rectangular" cols="1" rows="3" />
    <cell image="img_clutch.png">
     <media type="PLAY_AUDIO" level="1" file="desc_clutch.mp3" />
    </cell>
    <cell image="img_maple.png">
     <media type="PLAY_AUDIO" level="1" file="desc_maple.mp3" />
    </cell>
    <cell image="img_zayu.png">
     <media type="PLAY_AUDIO" level="1" file="desc_zayu.mp3" />
    </cell>
   </cells>
   <layout position="AB" />
  </activity>
