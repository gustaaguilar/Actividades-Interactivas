  <activity class="@associations.SimpleAssociation" name="aguila_caracteristicas" code="">
   <description />
   <messages>
    <cell type="initial">
     <style>
      <font family="Arial" size="18" bold="true" />
      <color foreground="0x003300" background="0xFFFFCC" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="cons_aguila_caract.mp3" />
     <p>Uní cada característica con la parte del cuerpo del águila calva.</p>
