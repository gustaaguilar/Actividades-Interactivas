  <activity class="@textGrid.WordSearch" name="review_wordsearch" code="">
   <description />
   <messages>
    <cell type="initial">
     <style>
      <font family="Arial" size="16" bold="true" />
      <color foreground="0xFFFFFF" background="0x1A4A1A" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="cons_wordsearch_review.mp3" />
     <p>Encontrá: COMPUTER – LAPTOP -  MOUSE – EMAIL – SUNNY – RAINY – CLOUDY - WINDY</p>
    </cell>
    <cell avoidOverlapping="true" image="i01-bienhecho.jpg" type="final">
     <style>
      <font family="Arial" size="24" bold="true" />
      <color foreground="0xFFFFFF" background="0x1A4A1A" />
     </style>
     <p>Great job!</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <helpWindow showSolution="true" />
    <container bgColor="0xC0C0C0">
     <gradient source="0x00CC00" dest="0x0A2A0A" angle="0" />
     <image name="fondo_review.jpg" tiled="true" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFF9900" transparent="true" border="false" />
   </settings>
