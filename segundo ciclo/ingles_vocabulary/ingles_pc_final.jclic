    <style margin="2" borderStroke="0.7" markerStroke="5.0">
     <font family="Arial" size="22" bold="true" />
     <color foreground="0xFFFFFF" background="0x009999" />
    </style>
    <text>
     <row>IZEKGKDHBGWR</row>
     <row>COMPUTERYKUH</row>
     <row>LTPKHYVGAXLI</row>
     <row>UKLAPTOPGLUS</row>
     <row>BQIYTHSZWECU</row>
     <row>ZBWEMAILWKLN</row>
     <row>CQBZFJSXTWON</row>
     <row>YOJRSIRQLAUY</row>
     <row>VDEAKCMATRDU</row>
     <row>WINDYRJAIVYB</row>
     <row>FKOMOUSECNFC</row>
     <row>OSDISFDBSPYA</row>
    </text>
   </textGrid>
   <clues>
    <clue id="0">COMPUTER</clue>
    <clue id="1">LAPTOP</clue>
    <clue id="2">MOUSE</clue>
    <clue id="3">EMAIL</clue>
    <clue id="4">SUNNY</clue>
    <clue id="5">RAINY</clue>
    <clue id="6">CLOUDY</clue>
    <clue id="7">WINDY</clue>
