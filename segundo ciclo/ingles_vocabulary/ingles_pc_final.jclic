     <color foreground="0x000066" background="0xFFFFFF" inactive="0xFFFFFF" />
     <gradient source="0xFF0000" dest="0xFFFFFF" angle="89" cycles="2" />
    </style>
    <shaper class="@Rectangular" cols="6" rows="1" />
    <cell avoidOverlapping="true">
