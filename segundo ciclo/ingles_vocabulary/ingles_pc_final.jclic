    </cell>
    <cell avoidOverlapping="true">
     <p>is</p>
    </cell>
    <cell avoidOverlapping="true">
     <p>sunny</p>
    </cell>
    <cell avoidOverlapping="true">
     <p>and</p>
    </cell>
    <cell avoidOverlapping="true">
     <p>hot</p>
    </cell>
    <cell avoidOverlapping="true">
