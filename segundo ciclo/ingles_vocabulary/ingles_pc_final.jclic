  <activity class="@puzzles.ExchangePuzzle" name="cierre" code="">
   <description />
   <messages>
    <cell type="initial">
     <style>
      <font family="Arial" size="22" bold="true" />
      <color foreground="0x003366" background="0xFFFFFF" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="cons_portadaclic.mp3" />
     <p>Build the puzzle! / ¡Armá el rompecabezas!</p>
    </cell>
    <cell avoidOverlapping="true" image="i01-bienhecho.jpg" type="final">
     <style>
      <font family="Arial" size="24" bold="true" />
      <color foreground="0xFFFFFF" background="0x003399" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="cons_cierre.mp3" />
     <p>Congratulations! You finished English. / ¡Felicitaciones! Terminaste Inglés.</p>
    </cell>
   </messages>
   <settings margin="8" dragCells="true" report="true" reportActions="false">
    <container bgColor="0xC0C0C0">
     <gradient source="0x00CCFF" dest="0xFFFFFF" angle="0" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFFFFF" border="true" />
   </settings>
   <cells rows="2" cols="3" border="true" image="cierre-resized2.jpg">
    <style />
