  <activity class="@textGrid.WordSearch" name="sopa1" code="">
   <description />
   <messages>
    <cell type="initial">
     <style>
      <font family="Arial" size="28" bold="true" />
      <color background="0xFF9966" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="cons_sopa.mp3" />
     <p>Encontrá las 8 palabras escondidas.</p>
    </cell>
    <cell avoidOverlapping="true" image="i02-i01-bienhecho.jpg" type="final">
     <style>
      <font family="Arial" size="28" bold="true" />
      <color background="0x00CC00" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="muy_bien.mp3" />
     <p>¡Muy bien!</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <helpWindow showSolution="true" />
    <container bgColor="0xC0C0C0">
     <gradient source="0x009999" dest="0xFFFFFF" angle="0" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xC0C0C0" border="true">
     <gradient source="0x999900" dest="0xFFFFFF" angle="0" />
    </window>
   </settings>
   <textGrid rows="10" columns="10" cellWidth="35.0" cellHeight="35.0" border="true">
    <style margin="4">
     <font family="Arial" size="20" bold="true" />
     <color foreground="0xFFFFFF" background="0x660066" />
    </style>
    <text>
     <row>*SUEÑO**E*</row>
     <row>*****MESSI</row>
     <row>********P*</row>
     <row>********AF</row>
     <row>TALENTO*ÑÚ</row>
     <row>ARGENTINAT</row>
     <row>********CB</row>
     <row>********OO</row>
     <row>********PL</row>
     <row>***MUNDIAL</row>
    </text>
   </textGrid>
   <clues>
    <clue id="0">MESSI</clue>
    <clue id="1">ARGENTINA</clue>
    <clue id="2">ESPAÑA</clue>
    <clue id="3">MUNDIAL</clue>
    <clue id="4">COPA</clue>
    <clue id="5">FÚTBOL</clue>
    <clue id="6">SUEÑO</clue>
    <clue id="7">TALENTO</clue>
   </clues>
   <cells rows="4" cols="2" cellWidth="110.0" cellHeight="76.0" border="true" id="secondary">
    <style borderStroke="0.7" markerStroke="5.0">
     <color background="0x666600" />
    </style>
    <shaper class="@Rectangular" cols="2" rows="4" />
    <cell image="fondo_09.jpg">
     <media type="PLAY_AUDIO" level="1" file="nom_messi.mp3" />
    </cell>
    <cell image="fondo_08.jpg">
