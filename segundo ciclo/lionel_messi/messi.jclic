    </cell>
    <cell image="fondo_07.jpg">
     <media type="PLAY_AUDIO" level="1" file="nom_mundial.mp3" />
    </cell>
    <cell image="fondo_05.jpg">
     <media type="PLAY_AUDIO" level="1" file="nom_copa.mp3" />
    </cell>
    <cell image="fondo_02.jpg">
     <media type="PLAY_AUDIO" level="1" file="nom_futbol.mp3" />
    </cell>
    <cell image="fondo_01.jpg">
     <media type="PLAY_AUDIO" level="1" file="nom_sueno.mp3" />
    </cell>
    <cell image="fondo_04.jpg">
     <media type="PLAY_AUDIO" level="1" file="nom_talento.mp3" />
