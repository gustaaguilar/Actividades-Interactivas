  <activity class="@text.FillInBlanks" name="rellena1" code="">
   <description />
   <messages>
    <cell type="initial">
     <style borderStroke="0.7" markerStroke="5.0">
      <font family="Arial" size="26" bold="true" />
      <color foreground="0xFFFFFF" background="0x990000" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="cons_completa.mp3" />
     <p>Completá la oración.</p>
    </cell>
    <cell avoidOverlapping="true" image="i01-bienhecho.jpg" type="final">
     <style>
      <font family="Arial" size="28" bold="true" />
      <color foreground="0xFFFFFF" background="0x009900" />
     </style>
     <media type="PLAY_AUDIO" level="1" file="excelente.mp3" />
     <p>¡Excelente!</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <container bgColor="0x00CC00">
     <image name="fondo_01.jpg" tiled="false" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xC0C0C0" border="true">
     <size width="760" height="220" />
    </window>
   </settings>
   <document>
    <style name="targetError" base="target" foreground="0xFF0000" />
    <style name="target" base="default" foreground="0x0000FF" target="true" />
    <style name="default" family="Arial" background="0xFFFFFF" size="26" bold="true" italic="false" tabWidth="12" />
    <section>
     <p family="Arial" background="0xFFFFFF">
      <text size="26">Lionel Messi nació en la </text>
      <target>
       <answer>provincia</answer>
       <response fill="_" length="9" maxLength="9" />
       <text>provincia</text>
      </target>
      <text size="26"> de Santa Fe, Argentina.</text>
     </p>
    </section>
   </document>
   <evaluator class="@ComplexEvaluator" />
  </activity>
